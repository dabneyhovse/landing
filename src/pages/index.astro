---
export const prerender = true;

import Footer from "../components/Footer.astro";
import Gallery from "../components/Gallery.astro";
import Hero from "../components/Hero.astro";
import SocialCalendar from "../components/SocialCalendar.astro";
import WhatWeDo from "../components/WhatWeDo.astro";

import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div
    class="flex flex-col gap-24 bg-darb-700 opacity-90 min-h-screen font-lexend text-cream-text lg:text-2xl"
  >
    <Hero />
    <WhatWeDo />
    <SocialCalendar />
    <Gallery />
    <Footer />
  </div>
</Layout>

<style>
  .font-lexend {
    font-family: var(--font-lexend);
  }
</style>
