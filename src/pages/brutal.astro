---
export const prerender = true;

import Footer from "../components/brutal/Footer.astro";
import Gallery from "../components/brutal/Gallery.astro";
import Hero from "../components/brutal/Hero.astro";
import SocialCalendar from "../components/brutal/SocialCalendar.astro";
import WhatWeDo from "../components/brutal/WhatWeDo.astro";

import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="brutal flex flex-col gap-24 min-h-screen font-dmsans">
    <Hero />
    <WhatWeDo />
    <SocialCalendar />
    <Gallery />
    <Footer />
  </div>
</Layout>

<style>
  body {
    background: linear-gradient(90deg, #80808033 1px, #0000 0),
      linear-gradient(#80808033 1px, #0000 0);
    background-size: 70px 70px;
    background-color: var(--background);
  }
  .font-dmsans {
    font-family: var(--font-dmsans);
  }
</style>
