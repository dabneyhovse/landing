---
import Layout from "../../layouts/Layout.astro";
import UserManagement from "../../components/admin/UserManagement";
import crest from "../../assets/crest.svg";

const user = Astro.locals.user;
if (!user) return Astro.redirect("/api/auth/login?returnTo=/admin");
if (!user.roles?.includes("website-manage-users") && !user.roles?.includes("backbone-admin")) {
  return new Response("Forbidden", { status: 403 });
}
---

<Layout>
  <div class="frotator-bg relative min-h-screen overflow-hidden font-lexend">
    <img
      src={crest.src}
      alt=""
      class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 rotate-12 opacity-[0.06] w-[700px] h-auto invert brightness-[2]"
    />
    <div class="relative z-10 mx-auto max-w-6xl px-4 py-8">
      <UserManagement client:load />
    </div>
  </div>
</Layout>

<style>
  .font-lexend {
    font-family: var(--font-lexend);
  }
  .frotator-bg {
    background: radial-gradient(ellipse at 50% 0%, rgba(255,255,255,0.06) 0%, transparent 60%),
                var(--background);
  }
</style>
